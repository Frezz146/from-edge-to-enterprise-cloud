            "query": "This is urgent - set up a high-priority 20-minute call with Priya Patel (priya.patel@example.com) about the production outage.",
            "expected_tool": "book_appointment_strict",
            "expected_parameters": {
                "attendee": { "name": "Priya Patel", "email": "priya.patel@example.com" },
                "topics": ["production outage"],
                "priority": "high",
                "duration_minutes": 20
            }
        },
        {
            "id": "case_07_no_rush",
            "query": "Just a quick ten-minute, no-rush chat with Devon Clarke (devon.clarke@example.com) about the intern onboarding checklist.",
            "expected_tool": "book_appointment_strict",
            "expected_parameters": {
                "attendee": { "name": "Devon Clarke", "email": "devon.clarke@example.com" },

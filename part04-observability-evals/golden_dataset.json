        {
            "id": "case_10_critical",
            "query": "This is critical - schedule a high-priority 60-minute review with Jordan Ellis (jordan.ellis@example.com) covering the compliance audit and the incident report.",
            "expected_tool": "book_appointment_strict",
            "expected_parameters": {

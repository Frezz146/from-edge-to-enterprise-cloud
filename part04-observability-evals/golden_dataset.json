                "duration_minutes": 30
            }
        },
        {
            "id": "case_09_two_low_topics",
            "query": "Set up a low-priority 15-minute check-in with Casey Morgan (casey.morgan@example.com) about desk setup and badge access.",
            "expected_tool": "book_appointment_strict",
            "expected_parameters": {
                "attendee": { "name": "Casey Morgan", "email": "casey.morgan@example.com" },
                "topics": ["desk setup", "badge access"],
                "priority": "low",
                "duration_minutes": 15
